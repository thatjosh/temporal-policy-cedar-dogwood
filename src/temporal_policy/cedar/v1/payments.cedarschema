// Types for the payment guardrails.
//
// A mistyped attribute name is not cosmetic: at run time the policy errors, an
// erroring policy is skipped, and the guardrail is gone. Validating against this
// turns that into a build-time failure, and rejects a malformed request too.

entity Agent;
entity Customer;
entity Order in Customer;

action pay
  appliesTo {
    principal: Agent,
    resource: Order,
    context: {
      // Money is always whole cents. Cedar's Long is a signed 64-bit integer.
      amount_cents: Long,
    }
  };
